generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserRole { PLAYER HOST MODERATOR ADMIN }
enum MatchStatus { IDLE QUEUED MATCH_FOUND ACCEPTING READY LOBBY IN_PROGRESS AWAITING_CONFIRMATION COMPLETED CANCELLED DISPUTED ABORTED EXPIRED }
enum MatchPlayerStatus { INVITED ACCEPTED DECLINED KICKED }
enum ConfirmationDecision { PENDING CONFIRMED DISPUTED }
enum PenaltyType { DECLINE NO_SHOW RESULT_ABUSE }
enum DisputeStatus { OPEN REVIEWING RESOLVED }

model User { id String @id @default(uuid()) email String @unique passwordHash String role UserRole @default(PLAYER) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt roblox RobloxAccount? stats PlayerStats? queueEntries Queue[] matches MatchPlayer[] hostedLobbies VipLobby[] confirmations ResultConfirmation[] penalties Penalty[] cooldowns Cooldown[] disputes Dispute[] adminActions AdminAction[] chats LobbyChatMessage[] }
model RobloxAccount { id String @id @default(uuid()) userId String @unique robloxUserId String @unique username String displayName String? verifiedAt DateTime @default(now()) createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model PlayerStats { id String @id @default(uuid()); userId String @unique; elo Int @default(1000); wins Int @default(0); losses Int @default(0); draws Int @default(0); games Int @default(0); kd Decimal @default(0); streak Int @default(0); user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Queue { id String @id @default(uuid()); userId String; format String; status String @default("WAITING"); joinedAt DateTime @default(now()); elo Int; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([userId,format]); @@index([format,status,elo,joinedAt]) }
model Match { id String @id @default(uuid()); format String; status MatchStatus @default(IDLE); map String?; scoreA Int?; scoreB Int?; winnerTeam String?; foundAt DateTime?; acceptDeadline DateTime?; startedAt DateTime?; completedAt DateTime?; hostUserId String?; idempotencyKey String? @unique; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; players MatchPlayer[]; teams Team[]; lobby VipLobby?; result MatchResult?; screenshots ResultScreenshot[]; confirmations ResultConfirmation[]; eloHistory EloHistory[]; disputes Dispute[]; @@index([status,createdAt]) }
model MatchPlayer { id String @id @default(uuid()); matchId String; userId String; teamId String?; status MatchPlayerStatus @default(INVITED); kills Int?; deaths Int?; acceptedAt DateTime?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); team Team? @relation(fields:[teamId],references:[id],onDelete:SetNull); @@unique([matchId,userId]) }
model Team { id String @id @default(uuid()); matchId String; name String; side String; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); players MatchPlayer[]; @@unique([matchId,side]) }
model VipLobby { id String @id @default(uuid()); matchId String @unique; code String @unique; joinUrl String?; hostUserId String; startedAt DateTime?; createdAt DateTime @default(now()); match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); host User @relation(fields:[hostUserId],references:[id],onDelete:Restrict); messages LobbyChatMessage[] }
model LobbyChatMessage { id String @id @default(uuid()); lobbyId String; userId String; message String; createdAt DateTime @default(now()); lobby VipLobby @relation(fields:[lobbyId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([lobbyId,createdAt]) }
model MatchResult { id String @id @default(uuid()); matchId String @unique; scoreA Int; scoreB Int; winnerTeam String; submittedBy String; submittedAt DateTime @default(now()); finalizedAt DateTime?; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade) }
model ResultScreenshot { id String @id @default(uuid()); matchId String; objectKey String; url String; sha256 String; size Int; mime String; createdAt DateTime @default(now()); match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); @@unique([matchId,sha256]) }
model ResultConfirmation { id String @id @default(uuid()); matchId String; userId String; decision ConfirmationDecision @default(PENDING); decidedAt DateTime?; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([matchId,userId]) }
model EloHistory { id String @id @default(uuid()); matchId String; userId String; beforeElo Int; delta Int; afterElo Int; kills Int?; deaths Int?; createdAt DateTime @default(now()); match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,createdAt]) }
model Penalty { id String @id @default(uuid()); userId String; type PenaltyType; reason String; eloDelta Int @default(0); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Cooldown { id String @id @default(uuid()); userId String; reason String; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,expiresAt]) }
model Dispute { id String @id @default(uuid()); matchId String; openedBy String; reason String; status DisputeStatus @default(OPEN); resolution String?; resolvedBy String?; createdAt DateTime @default(now()); resolvedAt DateTime?; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); user User @relation(fields:[openedBy],references:[id],onDelete:Restrict); @@index([status,createdAt]) }
model AdminAction { id String @id @default(uuid()); adminId String; action String; targetId String?; payload Json?; createdAt DateTime @default(now()); admin User @relation(fields:[adminId],references:[id],onDelete:Restrict); @@index([createdAt]) }
